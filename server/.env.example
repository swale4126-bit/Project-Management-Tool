# Server Runtime
NODE_ENV=development
PORT=5000

# PostgreSQL Connection (use your local development credentials in .env)
DATABASE_URL=postgresql://fieldledger_user:CHANGE_ME@localhost:5432/fieldledger_dev
TEST_DATABASE_URL=postgresql://fieldledger_user:CHANGE_ME@localhost:5432/fieldledger_test

# Authentication (generate a 64-byte random hex string for JWT_SECRET in .env)
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# CORS & Frontend Origin
CLIENT_ORIGIN=http://localhost:5173

# File Uploads
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads
